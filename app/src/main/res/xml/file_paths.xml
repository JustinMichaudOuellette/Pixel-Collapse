<?xml version="1.0" encoding="utf-8"?>
<!--
    The one directory a share sheet may read from: the cache folder ImageSaver writes a picture to
    before handing it out. Nothing else in the app is exposed.
-->
<paths>
    <cache-path
        name="shared_pictures"
        path="shared/" />
    <!--
        The camera app needs a writable URI for the full-size photo. The file lives in this app's
        cache/camera folder and is read back immediately, so nothing outside the app can reach it.
    -->
    <cache-path
        name="camera_photos"
        path="camera/" />
</paths>
